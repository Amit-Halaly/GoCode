<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_exercise_root"
    android:clipChildren="false"
    android:clipToPadding="false">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingStart="14dp"
        android:paddingTop="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="0dp">

        <LinearLayout
            android:id="@+id/header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/taskTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add two numbers"
                    android:textColor="#F8FAFC"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/taskSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Read two integers and print their sum."
                    android:textColor="#A7B4C8"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusPill"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:minWidth="86dp"
                android:paddingHorizontal="12dp"
                android:text="Ready"
                android:textColor="#EAF7FF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/editorCard"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="#07111D"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toTopOf="@id/outputCard"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/header"
            app:strokeColor="#263B52"
            app:strokeWidth="1dp">

            <FrameLayout
                android:id="@+id/editorContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <io.github.rosemoe.sora.widget.CodeEditor
                    android:id="@+id/codeEditor"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingTop="6dp" />

                <View
                    android:id="@+id/editorTouchOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:visibility="gone" />

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/leoTipGroup"
                    android:layout_width="match_parent"
                    android:layout_height="132dp"
                    android:layout_gravity="bottom"
                    android:paddingHorizontal="10dp"
                    android:paddingBottom="10dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivLeoOverlay"
                        android:layout_width="82dp"
                        android:layout_height="0dp"
                        android:elevation="30dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_standing_lion"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:id="@+id/tipBubble"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_tip_bubble"
                        android:orientation="vertical"
                        android:padding="10dp"
                        app:layout_constraintBottom_toBottomOf="@id/ivLeoOverlay"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/ivLeoOverlay"
                        app:layout_constraintTop_toTopOf="@id/ivLeoOverlay">

                        <TextView
                            android:id="@+id/tvTipTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="AI hint"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTipText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Tap for a focused clue."
                            android:textSize="12sp" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/outputCard"
            android:layout_width="0dp"
            android:layout_height="190dp"
            android:layout_marginBottom="10dp"
            app:cardBackgroundColor="#0C1826"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp"
            app:layout_constraintBottom_toTopOf="@id/actionBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:strokeColor="#24364A"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/answerButton"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:minWidth="82dp"
                        android:text="Answer"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        app:icon="@drawable/ic_lock_answer"
                        app:iconPadding="6dp"
                        app:iconTint="#FFFFFF"
                        app:backgroundTint="#3B2B66"
                        app:cornerRadius="8dp" />

                    <TextView
                        android:id="@+id/outputTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="Tests"
                        android:textColor="#E5F0FF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="6dp"
                    android:layout_weight="1"
                    android:fillViewport="true">

                    <TextView
                        android:id="@+id/outputView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:lineSpacingExtra="2dp"
                        android:text="READY  Warm up"
                        android:textColor="#B9C7D8"
                        android:textSize="12sp" />
                </ScrollView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/actionBar"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toTopOf="@id/symbolInput"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <EditText
                android:id="@+id/inputField"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_exercise_input"
                android:cursorVisible="false"
                android:focusable="false"
                android:hint="Input opens on Run"
                android:imeOptions="actionDone"
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:textColor="#EAF2FF"
                android:textColorHint="#718096"
                android:textSize="13sp" />

            <ProgressBar
                android:id="@+id/runProgress"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:indeterminateTint="#35E0A1"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/themeButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Toggle theme"
                android:text=""
                android:textAllCaps="false"
                app:backgroundTint="#152436"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_moon"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="#EAF2FF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/resetButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Reset code"
                android:text=""
                android:textAllCaps="false"
                app:backgroundTint="#152436"
                app:cornerRadius="8dp"
                app:icon="@drawable/ic_reset_code"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="#EAF2FF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/runButton"
                android:layout_width="92dp"
                android:layout_height="48dp"
                android:text="Run"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:backgroundTint="#10B981"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <io.github.rosemoe.sora.widget.SymbolInputView
            android:id="@+id/symbolInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:elevation="24dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/resultLottie"
        android:layout_width="210dp"
        android:layout_height="210dp"
        android:layout_gravity="center"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/introOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_exercise_overlay"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/introContent"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="28dp">

            <TextView
                android:id="@+id/introReadyText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="READY"
                android:textColor="#35E0A1"
                android:textSize="42sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/introTaskText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="Add two numbers"
                android:textColor="#F8FAFC"
                android:textSize="28sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/inputPromptOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC07111D"
        android:clickable="true"
        android:focusable="true"
        android:padding="22dp"
        android:visibility="gone">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/inputPromptCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardBackgroundColor="#101C2B"
            app:cardCornerRadius="8dp"
            app:cardElevation="8dp"
            app:strokeColor="#35E0A1"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/inputPromptTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Program input"
                    android:textColor="#F8FAFC"
                    android:textSize="21sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/inputPromptMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Enter the first number"
                    android:textColor="#A7B4C8"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/inputPromptField"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_exercise_input"
                    android:hint="Value"
                    android:inputType="text"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="#EAF2FF"
                    android:textColorHint="#718096"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="end"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/inputPromptCancel"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:text="Cancel"
                        android:textAllCaps="false"
                        app:backgroundTint="#1F2E40"
                        app:cornerRadius="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/inputPromptButton"
                        android:layout_width="wrap_content"
                        android:layout_height="46dp"
                        android:layout_marginStart="10dp"
                        android:text="Continue"
                        android:textAllCaps="false"
                        android:textStyle="bold"
                        app:backgroundTint="#10B981"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </FrameLayout>
</FrameLayout>
