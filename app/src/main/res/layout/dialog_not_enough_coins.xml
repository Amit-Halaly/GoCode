<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_unlock_warning_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="26dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <FrameLayout
        android:layout_width="86dp"
        android:layout_height="86dp"
        android:background="@drawable/bg_unlock_coin_stage"
        android:padding="14dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Coins"
            android:scaleType="fitCenter"
            android:src="@drawable/coin" />
    </FrameLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:text="Not enough coins"
        android:textColor="#F8FAFC"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:text="You need 50 coins to unlock this answer."
        android:textColor="#C9D6E6"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/notEnoughCoinsOkButton"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="24dp"
        android:text="OK"
        android:textAllCaps="false"
        android:textColor="#062016"
        android:textStyle="bold"
        app:backgroundTint="#FACC15"
        app:cornerRadius="8dp" />
</LinearLayout>
